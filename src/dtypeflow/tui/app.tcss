Screen {
    align: center top;
}

.hero {
    align: center middle;
    height: auto;
    padding: 2 4;
}

.app-title {
    text-style: bold;
    color: $accent;
    width: auto;
    content-align: center middle;
}

.app-subtitle {
    color: $text-muted;
    width: auto;
    content-align: center middle;
    margin-bottom: 1;
}

.panel {
    width: 100%;
    max-width: 90;
    height: auto;
    border: round $panel-lighten-2;
    padding: 1 2;
    margin: 1 0;
    background: $panel;
}

.field-row {
    height: auto;
    width: 100%;
    align: center middle;
}

.field-row Input {
    width: 1fr;
    margin-right: 1;
}

.primary-action {
    width: 100%;
    margin-top: 1;
}

.status {
    color: $warning;
    height: auto;
    margin-top: 1;
}

.status.-ok {
    color: $success;
}

.status.-error {
    color: $error;
}

#pick-file-screen {
    align: center middle;
}

#configure-header {
    width: 100%;
    height: auto;
    padding: 0 2;
    margin-bottom: 1;
    border-bottom: solid $panel-lighten-2;
}

#configure-columns {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

ColumnPanel {
    height: auto;
    width: 100%;
    padding: 0 1;
}

ColumnPanel .column-stats {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

ColumnPanel .column-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

ColumnPanel .column-recommended {
    color: $text-muted;
    text-style: bold;
    margin-bottom: 1;
}

ColumnPanel #dtype-tabs {
    margin-bottom: 1;
}

ColumnPanel .dtype-description {
    color: $text-muted;
    margin: 1 0;
}

ColumnPanel #dtype-options {
    height: auto;
    max-height: 16;
    border: round $panel-lighten-2;
}

ColumnPanel RadioSet {
    height: auto;
    border: none;
    background: transparent;
    margin: 1 0;
}

ColumnPanel .boolean-caption {
    margin-top: 1;
    color: $text-muted;
}

.dictionary-box {
    height: auto;
    width: 100%;
    margin-top: 1;
    border: round $panel-lighten-2;
    padding: 1;
}

CategoryOrderPicker {
    height: auto;
    width: 100%;
}

CategoryOrderPicker OptionList {
    height: auto;
    max-height: 12;
    border: round $panel-lighten-2;
}

CategoryOrderPicker .reorder-buttons {
    height: auto;
    width: 100%;
    align: center middle;
    margin-top: 1;
}

CategoryOrderPicker .reorder-buttons Button {
    margin: 0 1;
}

#configure-footer {
    height: auto;
    width: 100%;
    padding: 1 2;
    border-top: solid $panel-lighten-2;
}

#configure-footer-nav {
    height: auto;
    width: 100%;
    align: left middle;
}

.footer-counter {
    width: 1fr;
    content-align: center middle;
    color: $text-muted;
}

#configure-footer-nav Button {
    width: auto;
}

#export-result {
    height: 1fr;
    margin-top: 1;
}

.browse-modal {
    align: center middle;
}

.browse-dialog {
    width: 80%;
    height: 80%;
    max-width: 100;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.browse-dialog DirectoryTree {
    height: 1fr;
    border: round $panel-lighten-2;
    margin: 1 0;
}

.browse-buttons {
    height: auto;
    width: 100%;
    align: right middle;
    margin-top: 1;
}

.browse-buttons Button {
    margin-left: 1;
}
